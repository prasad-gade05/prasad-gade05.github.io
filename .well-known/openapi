    },
    "/api/about.json": {
      "get": {
        "summary": "Personality, hobbies, and interests",
        "description": "Returns site philosophy, hobbies, interests, site features, keyboard shortcut details, and blog pipeline architecture with caching behavior as JSON with meta and data wrappers.",
        "operationId": "getAbout",
        "tags": ["Personal"],
        "responses": {
          "200": {
            "description": "About data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
