        }
      }
    },
    "/blogs/blogs.json": {
      "get": {
        "summary": "Published blog metadata",
        "description": "Returns blog metadata generated by the static blog pipeline, including slugs, titles, dates, thumbnails, categories, excerpts, read times, and URLs.",
        "operationId": "getBlogs",
        "tags": ["Blogs"],
        "responses": {
          "200": {
            "description": "Published blog metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "slug": { "type": "string" },
                      "title": { "type": "string" },
                      "date": { "type": "string" },
                      "thumbnail": { "type": "string" },
                      "categories": { "type": "array", "items": { "type": "string" } },
                      "excerpt": { "type": "string" },
                      "readTime": { "type": "integer" },
                      "url": { "type": "string" }
                    },
                    "required": ["slug", "title", "date", "thumbnail", "categories", "excerpt", "readTime", "url"]
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "tags": [
