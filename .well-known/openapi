                      }
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "projects": {
                          "type": "array",
                          "items": { "type": "object" }
                        }
                      }
                    }
                  },
                  "required": ["meta", "data"]
                }
              }
            }
          }
        }
      }
    },
    "/api/skills.json": {
      "get": {
        "summary": "Strict MAIN_RESUME skills",
        "description": "Returns technical skills as JSON using the strict MAIN_RESUME taxonomy.",
        "operationId": "getSkills",
        "tags": ["Professional"],
        "responses": {
          "200": {
