                        "version": { "type": "string" },
                        "description": { "type": "string" }
                      }
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "categories": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "array",
                            "items": { "type": "string" }
                          }
                        }
                      }
                    }
                  },
                  "required": ["meta", "data"]
                }
              }
            }
          }
        }
      }
    },
    "/api/social.json": {
      "get": {
        "summary": "Contact and social profiles",
        "description": "Returns contact details and social media profiles as JSON with meta and data wrappers.",
        "operationId": "getSocial",
